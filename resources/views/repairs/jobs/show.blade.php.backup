<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        if (document.getElementById('part-select')) {
            new TomSelect('#part-select', {
                create: false,
                sortField: {
                    field: "text",
                    direction: "asc"
                },
                placeholder: 'Search for a part...',
                maxOptions: 50,
                onChange: function(value) {
                    let stockDisplay = document.getElementById('part-stock-display');
                    let stockValue = document.getElementById('part-stock-value');
                    let priceInput = document.getElementById('part-price');
                    
                    if (!value) {
                        stockDisplay.classList.add('hidden');
                        priceInput.value = '';
                        return;
                    }
                    
                    let select = document.getElementById('part-select');
                    let option = select.querySelector('option[value="' + value + '"]');
                    
                    if (option && option.dataset) {
                        if (option.dataset.price) {
                            priceInput.value = option.dataset.price;
                        }
                        if (option.dataset.stock !== undefined) {
                            stockValue.textContent = Number(option.dataset.stock).toFixed(2);
                            stockDisplay.classList.remove('hidden');
                        }
                    }
                }
            });
        }
    });
</script>
